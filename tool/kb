#!/usr/bin/env python3
"""Help maintain a knowledge base that follows the .kb/agents.md rules.

Exit codes: 0 = clean, 1 = findings, 2 = tool error.
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from collections.abc import Iterator
from dataclasses import dataclass
from pathlib import Path

HANDSHAKE = "Read the top-level `.kb/agents.md` file before continuing below."
HANDSHAKE_ROOT = "Read the top-level `.kb/agents.md` before continuing below."
KB_HEADERS = frozenset(
    {"Preface", "Overview", "Important", "Architecture", "Documents"}
)
AGENTS_HEADERS = KB_HEADERS | {"Directory"}
HEADING = re.compile(r"^ {0,3}#(?:[ \t]+(.*)|[ \t]*)$")
FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
LIST_MARKER = re.compile(r"^(?:[-+*]|[0-9]+[.)])(?:[ \t]|$)")
LIST_ENTRY = re.compile(r"^- `[^`]+` - \S.*$")


@dataclass(frozen=True)
class Finding:
    path: Path
    line: int
    check: str
    message: str


def content_lines(text: str) -> Iterator[tuple[int, str]]:
    """Yield numbered lines outside fenced code blocks."""
    fence_marker = ""
    for number, line in enumerate(text.splitlines(), 1):
        match = FENCE.match(line)
        if match:
            marker, suffix = match.groups()
            if fence_marker:
                if (
                    marker[0] == fence_marker[0]
                    and len(marker) >= len(fence_marker)
                    and not suffix.strip()
                ):
                    fence_marker = ""
                continue
            if marker[0] == "~" or "`" not in suffix:
                fence_marker = marker
                continue
        if not fence_marker:
            yield number, line


def git(directory: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(directory), "--literal-pathspecs", *args],
        capture_output=True,
        text=True,
        check=False,
    )


def is_knowledge_file(path: Path) -> bool:
    return path.name == "AGENTS.md" or (
        path.parent.name == ".kb" and path.suffix == ".md"
    )


def heading_name(line: str) -> str | None:
    match = HEADING.fullmatch(line)
    if match is None:
        return None
    name = (match.group(1) or "").strip()
    return re.sub(r"(?:^|[ \t]+)#+$", "", name).rstrip()


def plural(count: int, noun: str) -> str:
    return f"{count} {noun}{'' if count == 1 else 's'}"


@dataclass(frozen=True)
class Document:
    path: Path
    top: Path
    text: str
    lines: tuple[tuple[int, str], ...]

    @property
    def is_agents(self) -> bool:
        return self.path.name == "AGENTS.md"

    @property
    def is_rules(self) -> bool:
        return self.path == self.top / ".kb/agents.md"


class Lint:
    def __init__(self, *paths: Path) -> None:
        self.paths = [Path(os.path.abspath(path)) for path in paths]
        self.findings: list[Finding] = []
        self.documents: list[Document] = []

    def flag(self, path: Path, line: int, check: str, message: str) -> None:
        self.findings.append(Finding(path, line, check, message))

    def repository(self, path: Path, directory: Path) -> Path | None:
        """Return the top-level of the git repository holding directory."""
        try:
            top = git(directory, "rev-parse", "--show-toplevel")
        except OSError as error:
            self.flag(path, 0, "tool-error", f"cannot run git: {error.strerror}")
            return None
        if top.returncode != 0:
            self.flag(path, 0, "tool-error", "not inside a git repository")
            return None
        return Path(top.stdout.strip())

    def discover(self) -> None:
        """Collect knowledge files that git tracks or would track, honouring ignores."""
        targets = self.paths
        if not targets:
            top = self.repository(Path.cwd(), Path.cwd())
            if top is None:
                return
            targets = [top]

        found: set[tuple[Path, Path]] = set()
        for path in targets:
            try:
                if not os.path.lexists(path):
                    self.flag(path, 0, "tool-error", "no such file or directory")
                    continue
                is_directory = path.is_dir()
            except OSError as error:
                self.flag(path, 0, "tool-error", f"cannot inspect: {error.strerror}")
                continue
            directory, pathspec = (path, ".") if is_directory else (path.parent, path.name)
            top = self.repository(path, directory)
            if top is None:
                continue
            listing = git(
                directory,
                "ls-files",
                "-z",
                "--full-name",
                "--cached",
                "--others",
                "--exclude-standard",
                "--",
                pathspec,
            )
            if listing.returncode != 0:
                message = listing.stderr.strip() or "cannot list files"
                self.flag(path, 0, "tool-error", message)
                continue
            found.update(
                (top, top / name)
                for name in listing.stdout.split("\0")
                if name and is_knowledge_file(Path(name))
            )

        for top, path in sorted(found):
            # Files deleted from the working tree are still listed from the index.
            if not os.path.lexists(path):
                continue
            try:
                text = path.read_text(encoding="utf-8")
            except UnicodeDecodeError:
                self.flag(path, 0, "tool-error", "cannot read: not valid UTF-8")
                continue
            except OSError as error:
                reason = error.strerror or error
                self.flag(path, 0, "tool-error", f"cannot read: {reason}")
                continue
            self.documents.append(
                Document(path, top, text, tuple(content_lines(text)))
            )

    def check_shape(self, document: Document) -> None:
        first = next(
            (
                (number, line)
                for number, line in enumerate(document.text.splitlines(), 1)
                if line.strip()
            ),
            None,
        )
        if first is None:
            self.flag(
                document.path,
                1,
                "preface-first",
                "the file is empty; start it with '# Preface'",
            )
        elif first[1] != "# Preface":
            self.flag(
                document.path,
                first[0],
                "preface-first",
                "the file must start with '# Preface'",
            )

        allowed_headers = KB_HEADERS
        if document.is_agents:
            allowed_headers = AGENTS_HEADERS
        elif document.is_rules:
            allowed_headers = KB_HEADERS | {"Headers"}

        documents_line = 0
        preface_end = 0
        preface_last = ""
        section = None
        for number, line in document.lines:
            heading = heading_name(line)
            if heading is not None:
                if document.is_agents and documents_line:
                    self.flag(
                        document.path,
                        number,
                        "documents-last",
                        f"'# {heading}' follows '# Documents' (line {documents_line}); "
                        "Documents must be the last section",
                    )
                if heading not in allowed_headers:
                    self.flag(
                        document.path,
                        number,
                        "allowed-headers",
                        f"header '{heading}' is not allowed; use one of "
                        f"{', '.join(sorted(allowed_headers))}",
                    )
                if heading == "Documents" and not documents_line:
                    documents_line = number
                if heading == "Preface" and not preface_end:
                    preface_end = number
                section = heading
            elif section == "Preface" and line.strip():
                preface_last, preface_end = line.strip(), number

        if not document.is_agents:
            handshakes = {HANDSHAKE}
            if document.is_rules:
                handshakes.add(HANDSHAKE_ROOT)
            if preface_last not in handshakes:
                self.flag(
                    document.path,
                    preface_end or 1,
                    "handshake-line",
                    f'the Preface must end with the line "{HANDSHAKE}"',
                )

    def check_listings(self, document: Document) -> None:
        if not document.is_agents:
            return
        section = None
        for number, line in document.lines:
            heading = heading_name(line)
            if heading is not None:
                section = heading
                continue
            if section not in {"Directory", "Documents"} or not LIST_MARKER.match(line):
                continue
            if not LIST_ENTRY.fullmatch(line):
                self.flag(
                    document.path,
                    number,
                    "listing-format",
                    f"{section} items must read '- `name` - Brief description.'",
                )

    def run(self) -> int:
        self.findings.clear()
        self.documents.clear()
        self.discover()
        for document in self.documents:
            self.check_shape(document)
            self.check_listings(document)
        self.findings.sort(key=lambda finding: (finding.path, finding.line))
        if any(finding.check == "tool-error" for finding in self.findings):
            return 2
        return 1 if self.findings else 0


def lint_command(args: argparse.Namespace) -> int:
    lint = Lint(*args.paths)
    exit_code = lint.run()
    problems = [finding for finding in lint.findings if finding.check != "tool-error"]
    for finding in lint.findings:
        location = os.path.relpath(finding.path)
        if finding.check == "tool-error":
            print(f"kb lint: {location}: {finding.message}", file=sys.stderr)
        else:
            print(f"{location}:{finding.line}: {finding.message}")
    if problems:
        files = len({finding.path for finding in problems})
        print(
            f"kb lint: {plural(len(problems), 'problem')} in {plural(files, 'file')}. "
            "Fix them to follow the rules in .kb/agents.md, then run kb lint again."
        )
    elif exit_code == 0 and lint.documents:
        print(
            f"kb lint: {plural(len(lint.documents), 'file')} checked, no problems found."
        )
    elif exit_code == 0:
        print("kb lint: no AGENTS.md or .kb/*.md files to check.")
    return exit_code


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="kb", description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)
    lint_parser = commands.add_parser(
        "lint", help="check AGENTS.md and .kb/*.md files against the rules"
    )
    lint_parser.add_argument(
        "paths",
        nargs="*",
        type=Path,
        metavar="PATH",
        help="files or directories to check (default: the whole repository)",
    )
    lint_parser.set_defaults(run=lint_command)
    args = parser.parse_args(argv)
    return args.run(args)


if __name__ == "__main__":
    raise SystemExit(main())
